# Copy this file to android/keystore.properties and fill in your real values.
# NEVER commit keystore.properties or the keystore file itself.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias release
#
# storeFile is relative to the android/ project root.
storeFile=keystore/release.jks
storePassword=CHANGE_ME
keyAlias=release
keyPassword=CHANGE_ME
