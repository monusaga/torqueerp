# Google Sign-In for the web app. Configure ONE of the two mechanisms below.
# The backend must be configured with the matching value
# (backend/.env: FIREBASE_PROJECT_ID or GOOGLE_CLIENT_ID).

# Option 1 (recommended): Firebase Authentication with the Google provider.
# Create a project at https://console.firebase.google.com, enable
# Authentication > Sign-in method > Google, then copy the web app config here.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Option 2: Google Identity Services. OAuth 2.0 Web Client ID from
# https://console.cloud.google.com/apis/credentials (add your site origin
# to "Authorized JavaScript origins").
VITE_GOOGLE_CLIENT_ID=""
