# Production build-time configuration for the web app.
#
# SAFE TO COMMIT: a Google OAuth *Web client ID* is a public identifier by
# design — it is embedded in every served page and is not a secret. Real
# secrets (JWT secret, DB credentials, API keys) stay in the server-side
# backend/.env, which is never committed.
VITE_GOOGLE_CLIENT_ID="699520506591-11l0r0mh2csfitm9n1rfugitc18t57r0.apps.googleusercontent.com"
