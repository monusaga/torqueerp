# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=https://your-domain.com
API_URL=https://api.your-domain.com

# Database Configuration
# Production (MySQL — matches prisma/schema.prisma):
DATABASE_URL="mysql://user:password@localhost:3306/spareparts_erp"
# Local development uses SQLite with the dev schema instead
# (npm run dev / npm test use prisma/schema.sqlite.prisma automatically):
# DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="your-256-bit-secret"
JWT_EXPIRES_IN="7d"

# Google Sign-In (server-side ID token verification). Configure at least one:
# 1) Google Identity Services: OAuth 2.0 Web Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
# 2) Firebase Authentication (Google provider): your Firebase project ID from https://console.firebase.google.com
FIREBASE_PROJECT_ID=""

# Reverse proxy hops in front of the app (nginx/Hostinger = 1, Cloudflare +
# nginx = 2). Required for correct client IPs and per-IP rate limiting.
# Defaults to 1 when NODE_ENV=production, and to no trust in development.
TRUST_PROXY=1

# CORS: allowed browser origin(s) for the web app. Required in production
# (NODE_ENV=production blocks all browser origins when this is unset).
# Single origin or comma-separated allowlist. Native mobile apps are
# unaffected by CORS. Local development example:
CORS_ORIGIN=http://localhost:3000

# Default Locale & Business Settings
DEFAULT_CURRENCY="INR"
DEFAULT_TIMEZONE="Asia/Kolkata"
